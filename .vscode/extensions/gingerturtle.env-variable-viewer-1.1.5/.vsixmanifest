<?xml version="1.0" encoding="utf-8"?>
	<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
		<Metadata>
			<Identity Language="en-US" Id="env-variable-viewer" Version="1.1.5" Publisher="GingerTurtle" />
			<DisplayName>Environment Variable Viewer - .env &amp; dotenv File Manager</DisplayName>
			<Description xml:space="preserve">.env file viewer &amp; dotenv manager for VS Code. View, search, copy, export &amp; validate environment variables. Supports .env.local, .env.production, .env.development &amp; custom files. Tree view, quick pick, masking &amp; validation. React, Next.js, Vue, Angular, Svelte, Node.js, NestJS, Python, Docker &amp; Kubernetes.</Description>
			<Tags>env,dotenv,.env,.env file,environment variables,env file,env viewer,dotenv viewer,env file viewer,env file browser,env browser,environment file viewer,env manager,env editor,.env editor,dotenv editor,dotenv manager,dotenv extension,dotenv plugin,dotenv support,dotenv tool,env inspector,env reader,configuration,environment variable manager,environment variable viewer,env file reader,env file manager,dotenv config,secrets,secret manager,api keys,api key viewer,api key manager,env.local,env.production,env.development,env.test,env.example,react env,node env,nextjs env,vite env,vue env,docker env,nestjs env,nuxt env,environment file,env variables,dotenv file,dotenv variables,process.env,export env,copy env,validate env,env validation,env export,env loader,env parser,devops,nodejs,react,nextjs,vue,angular,svelte,sveltekit,vite,nestjs,nuxt,nuxtjs,express,fastify,remix,astro,docker,kubernetes,twelve-factor,12-factor,keybindings,javascript,node,python,__sponsor_extension</Tags>
			<Categories>Other,Programming Languages,Linters</Categories>
			<GalleryFlags>Public</GalleryFlags>
			
