# Production Environment Variables
# Critical production configuration

# Database - Production
DB_HOST=prod-db.company.com
DB_NAME="myapp_production"
DB_USER=prod_readonly
DB_SSL=true
DB_CONNECTION_POOL_SIZE=20

# API - Production
API_BASE_URL=https://api.company.com/v1
API_TIMEOUT=10000
API_RATE_LIMIT=1000

# Security - Production
JWT_EXPIRES_IN=15m
CORS_ORIGIN=https://company.com
HTTPS_ONLY=true
SECURITY_HEADERS=true

# Performance
CACHE_TTL=3600
CDN_URL=https://cdn.company.com
GZIP_COMPRESSION=true

# Monitoring - Production
LOG_LEVEL=warn
ENABLE_ANALYTICS=true
PERFORMANCE_MONITORING=true

# Production Services
REDIS_URL=redis://prod-redis.company.com:6379
ELASTICSEARCH_URL=https://prod-search.company.com:9200