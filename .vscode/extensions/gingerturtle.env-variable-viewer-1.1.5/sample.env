# Sample .env file for testing Environment Variable Viewer Extension
# This file demonstrates various environment variable formats

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME="my_awesome_app"
DB_USER=admin
DB_PASSWORD=super_secret_password
DB_SSL=true

# API Configuration
API_KEY=abc123xyz789
API_SECRET='very-secret-api-key'
API_BASE_URL=https://api.example.com/v1
API_TIMEOUT=30000
API_RETRIES=3

# Authentication
JWT_SECRET=jwt-super-secret-key
JWT_EXPIRES_IN=24h
OAUTH_CLIENT_ID=oauth_client_123
OAUTH_CLIENT_SECRET=oauth_secret_456

# Feature Flags
ENABLE_LOGGING=true
DEBUG_MODE=false
ENABLE_ANALYTICS=true
MAINTENANCE_MODE=false

# External Services
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
EMAIL_SERVICE_API_KEY=email_service_key_123

# Application Settings
APP_NAME="Environment Variable Viewer Test App"
APP_VERSION=1.0.0
APP_ENV=development
PORT=3000
HOST=0.0.0.0

# Cloud Configuration
AWS_ACCESS_KEY_ID=aws_access_key_123
AWS_SECRET_ACCESS_KEY=aws_secret_key_456
AWS_REGION=us-west-2
S3_BUCKET_NAME=my-app-bucket

# Third-party Integrations
STRIPE_PUBLISHABLE_KEY=pk_test_123456789
STRIPE_SECRET_KEY=sk_test_987654321
SENDGRID_API_KEY=sendgrid_key_123
TWILIO_ACCOUNT_SID=twilio_account_123
TWILIO_AUTH_TOKEN=twilio_token_456

# Monitoring
SENTRY_DSN=https://sentry.example.com/123
NEW_RELIC_LICENSE_KEY=newrelic_key_123
DATADOG_API_KEY=datadog_key_456